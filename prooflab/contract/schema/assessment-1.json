  "control_ref",
  "control_id",
  "threshold_version",
  "threshold_sha256",
  "register_version",
  "scope_kind",
  "scope_id",
  "scope_start",
  "scope_end",
  "requirement_verdict",
  "design",
  "operation",
  "deficiency",
  "evidence_sufficiency",
  "measured",
  "exceptions",
  "denominators",
  "completeness",
  "formula",
  "evidence_refs",
  "gaps",
  "evaluator_name",
  "evaluator_sha256",
  "as_of",
  "snapshot_id"
 ],
 "properties": {
