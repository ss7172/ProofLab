  },
  "denominators": {
   "type": "object"
  },
  "completeness": {
   "type": "object"
  },
  "formula": {},
  "evidence_refs": {
   "type": "array"
  },
  "gaps": {
   "type": "array"
  },
  "evaluator_name": {},
  "evaluator_sha256": {},
